---
import Base from '../layouts/Base.astro';
import StoreButtons from '../components/StoreButtons.astro';
---
<Base title="Kamer Annual Plan Offer" description="Claim your Kamer Annual Plan offer: 2 months free trial, then 20% off." noindex>
  <section class="section tight">
    <div class="wrap split" style="align-items:start">
      <div>
        <span class="eyebrow">Special Offer</span>
        <h1 class="te">Kamer Annual Plan పై <span class="hl">20% Discount</span></h1>
        <p class="lead te">మీ Hostel ను ఒకే App లో నడపండి. Beds, Rent, Reminders, Reports అన్నీ.</p>

        <div class="price">
          <span class="old">₹9,999</span>
          <span class="new">₹7,999</span>
          <span class="per">per year</span>
        </div>

        <ul class="check-list te">
          <li><strong>2 నెలలు Free Trial</strong></li>
          <li>ఆ తర్వాత Annual Plan పై <strong>20% Discount</strong></li>
          <li>Offer Code మరియు App Download link మీ WhatsApp కి వస్తుంది</li>
        </ul>
      </div>

      <div class="card" id="claim">
        <div id="form-wrap">
          <h2 style="font-size:1.5rem">Claim your offer</h2>
          <p class="muted">Enter your details. We send the offer code and the app link on WhatsApp.</p>
          <form id="offer-form" novalidate>
            <label>Your name
              <input name="name" required maxlength="80" autocomplete="name" />
            </label>
            <label>Phone (WhatsApp)
              <span class="phone-field">
                <span class="cc">+91</span>
                <input name="phone" type="tel" required inputmode="numeric" autocomplete="tel-national" maxlength="14" placeholder="98765 43210" />
              </span>
            </label>
            <label><span>Hostel name <span class="muted">(optional)</span></span>
              <input name="hostel" maxlength="120" />
            </label>
            <input class="hp" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <label class="consent">
              <input type="checkbox" name="consent" required />
              <span>I agree to receive the offer and app link on WhatsApp.</span>
            </label>
            <p id="form-error" class="error" role="alert" hidden></p>
            <button type="submit" class="btn primary" id="submit-btn">Get my offer</button>
          </form>
        </div>

        <div id="thanks" hidden>
          <h2 style="font-size:1.5rem">Thank you! 🙏</h2>
          <div id="code-box" hidden>
            <p class="te" style="margin-bottom:6px">మీ Offer Code</p>
            <div class="code-row">
              <strong id="offer-code" class="code"></strong>
              <button type="button" class="btn ghost small" id="copy-code">Copy</button>
            </div>
            <p class="muted" style="font-size:.9rem">Take a screenshot or note this code. Quote it when you sign up.</p>
          </div>
          <p class="te">ఈ Code మరియు App Download link మీ WhatsApp కి కూడా పంపుతున్నాము.</p>
          <p class="muted">Don't want to wait? Download the app now and start your 2-month free trial.</p>
          <StoreButtons />
          <p><a class="brochure" href="/kamer-brochure.pdf" target="_blank" rel="noopener">View the Kamer brochure (PDF)</a></p>
        </div>
      </div>
    </div>
  </section>
</Base>
<script>
  const form = document.getElementById('offer-form') as HTMLFormElement;
  const btn = document.getElementById('submit-btn') as HTMLButtonElement;
  const errBox = document.getElementById('form-error') as HTMLElement;
  const params = new URLSearchParams(location.search);
  const UTM = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'];

  const MESSAGES: Record<string, string> = {
    name_required: 'Please enter your name.',
    invalid_phone: 'Please enter a valid 10-digit mobile number.',
    consent_required: 'Please tick the WhatsApp consent box.',
  };

  document.getElementById('copy-code')?.addEventListener('click', async (e) => {
    const code = document.getElementById('offer-code')!.textContent || '';
    try {
      await navigator.clipboard.writeText(code);
      (e.target as HTMLButtonElement).textContent = 'Copied';
    } catch {
      (e.target as HTMLButtonElement).textContent = 'Press and hold the code to copy';
    }
  });

  function showError(msg: string) {
    errBox.textContent = msg;
    errBox.hidden = false;
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errBox.hidden = true;
    const d = new FormData(form);
    const digits = String(d.get('phone') || '').replace(/\D/g, '').replace(/^(91|0)(?=\d{10}$)/, '');
    if (!String(d.get('name') || '').trim()) return showError(MESSAGES.name_required);
    if (!/^[6-9]\d{9}$/.test(digits)) return showError(MESSAGES.invalid_phone);
    if (!d.get('consent')) return showError(MESSAGES.consent_required);

    const utm: Record<string, string> = {};
    for (const k of UTM) if (params.get(k)) utm[k] = params.get(k)!;

    btn.disabled = true;
    btn.textContent = 'Sending…';
    try {
      const r = await fetch('/api/leads', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: d.get('name'),
          phone: digits,
          hostel: d.get('hostel'),
          website: d.get('website'),
          consent: true,
          src: params.get('src') || 'direct',
          utm,
        }),
      });
      const j = await r.json().catch(() => ({}));
      if (!r.ok || !j.ok) throw new Error(j.error || 'server_error');
      document.getElementById('form-wrap')!.hidden = true;
      document.getElementById('thanks')!.hidden = false;
      if (j.code) {
        document.getElementById('offer-code')!.textContent = j.code;
        document.getElementById('code-box')!.hidden = false;
      }
    } catch (err) {
      showError(MESSAGES[(err as Error).message] || 'Something went wrong. Please try again, or WhatsApp us on +91 91000 91343.');
      btn.disabled = false;
      btn.textContent = 'Get my offer';
    }
  });
</script>
<style>
  .split > * { min-width: 0; }
  .te { font-family: var(--telugu); }
  h1.te { font-size: clamp(1.9rem, 4.6vw, 3rem); line-height: 1.3; }
  .hl { color: var(--orange-dark); }
  .price { display: flex; align-items: baseline; gap: 14px; flex-wrap: wrap; margin: 8px 0 22px; }
  .price .old { font-size: 1.5rem; color: var(--muted); text-decoration: line-through; }
  .price .new { font-size: clamp(2.6rem, 6vw, 3.6rem); font-weight: 800; color: var(--orange-dark); letter-spacing: -0.03em; line-height: 1; }
  .price .per { color: var(--muted); font-weight: 600; }
  form { display: grid; gap: 14px; margin-top: 18px; }
  label { display: grid; gap: 6px; font-weight: 600; font-size: .92rem; }
  input:not([type='checkbox']) { font: inherit; width: 100%; padding: 12px 14px; border: 1px solid var(--line); border-radius: 10px; background: var(--bg); }
  input:focus { outline: 2px solid var(--orange); border-color: transparent; }
  .phone-field { display: flex; align-items: stretch; gap: 8px; }
  .cc { display: grid; place-items: center; padding: 0 14px; border: 1px solid var(--line); border-radius: 10px; background: var(--surface-2); font-weight: 700; }
  .consent { display: flex; gap: 10px; align-items: flex-start; font-weight: 500; }
  .consent input { margin-top: 4px; width: 18px; height: 18px; accent-color: var(--orange); flex: none; }
  .code-row { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin: 4px 0 8px; }
  .code { font-size: 1.8rem; letter-spacing: .06em; color: var(--orange-dark); background: var(--orange-soft); padding: 8px 16px; border-radius: 10px; }
  .brochure { display: inline-block; margin-top: 16px; color: var(--orange-dark); font-weight: 600; text-decoration: underline; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .error { color: #b3261e; font-weight: 600; margin: 0; }
  .btn:disabled { opacity: .6; cursor: default; transform: none; }
</style>
