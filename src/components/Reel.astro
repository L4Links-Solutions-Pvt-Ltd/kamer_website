---
// Vertical reel in a phone frame. Self-hosted mp4, plays on tap.
interface Props { src: string; poster: string; title: string; who: string; length: string }
const { src, poster, title, who, length } = Astro.props;
---
<figure class="reel">
  <div class="phone">
    <video preload="none" poster={poster} playsinline controls>
      <source src={src} type="video/mp4" />
    </video>
    <span class="len">{length}</span>
  </div>
  <figcaption><strong>{title}</strong><span>{who}</span></figcaption>
</figure>
<script>
  const all = Array.from(document.querySelectorAll<HTMLVideoElement>('video'));
  all.forEach((v) => v.addEventListener('play', () => all.forEach((o) => { if (o !== v) o.pause(); })));
</script>
<style>
  .reel { margin: 0; width: 100%; max-width: 300px; }
  .phone { position: relative; aspect-ratio: 9 / 16; border-radius: 34px; background: #111; padding: 10px; box-shadow: 0 24px 50px rgba(31,36,48,.22), inset 0 0 0 2px #2a2a2a; }
  video { display: block; width: 100%; height: 100%; object-fit: cover; border-radius: 26px; background: #000; }
  .len { position: absolute; top: 20px; right: 20px; background: rgba(0,0,0,.6); color: #fff; font-size: .75rem; font-weight: 700; padding: 3px 8px; border-radius: 999px; pointer-events: none; }
  figcaption { margin-top: 14px; display: flex; flex-direction: column; gap: 2px; }
  figcaption strong { font-size: 1rem; }
  figcaption span { color: var(--muted); font-size: .9rem; }
</style>
